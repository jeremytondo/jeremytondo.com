// Cloudflare Workers config. The site is static: no Worker script, just the
// files `npm run build` writes to dist/ (including dist/_headers).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "jeremytondo-com",
  "compatibility_date": "2026-11-14",
  // Per-version and per-branch preview URLs on workers.dev, uploaded by CI for each PR.
  // Set explicitly because `wrangler deploy` leaves the dashboard setting alone otherwise.
  "preview_urls": true,
  "assets": {
    "directory": "./dist"
  },
  // `npm run preview`: same port as `npm run dev`, localhost only (see README → Tailscale).
  "dev": {
    "ip": "localhost",
    "port": 4321
  }
}
