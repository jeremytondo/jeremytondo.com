// Cloudflare Workers config. The site is static: no Worker script, just the
// files `npm run build` writes to dist/ (including dist/_headers).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "jeremytondo-com",
  "compatibility_date": "2026-11-14",
  // workers.dev URLs, applied on each `wrangler deploy` (both override the dashboard toggles).
  // Production is served only on the custom domain (attached in the dashboard, not here),
  // so the production workers.dev URL stays off; Wrangler would turn it on by default.
  "workers_dev": false,
  // Per-version and per-branch preview URLs, which CI uploads for each PR.
  "preview_urls": true,
  "assets": {
    "directory": "./dist"
  },
  // `npm run preview`: same port as `npm run dev`, localhost only (see README → Tailscale).
  "dev": {
    "ip": "localhost",
    "port": 4321
  }
}
